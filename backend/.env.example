# Copy this file to backend/.env and replace the credential placeholders.
# Run backend commands from backend/ so dotenv loads that file.

# Server and frontend origin
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB: use this local database or replace with your Atlas connection URI.
MONGODB_URI=mongodb://127.0.0.1:27017/ai-fitness-coach

# Google Gemini API key (server only; never use a VITE_ prefix)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
# GOOGLE_API_KEY is also accepted if GEMINI_API_KEY is unset.

# Firebase Admin: use the same Firebase project as the client.
# Copy these values from your Firebase service-account credentials.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@your-project-id.iam.gserviceaccount.com
# Keep the surrounding quotes and use \n for the private key's line breaks.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Alternative: set this to the complete service-account JSON on one line.
# When populated, it takes precedence over the three separate fields above.
# FIREBASE_SERVICE_ACCOUNT=
